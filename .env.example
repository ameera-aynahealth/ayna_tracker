# Postgres connection string (Neon recommended). Use the pooled connection
# string from Neon's dashboard for DATABASE_URL.
DATABASE_URL=postgres://user:password@host/dbname

# Clerk (https://dashboard.clerk.com -> your app -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Resend (phase 3 - not required yet, added here so it's ready)
RESEND_API_KEY=

# Cron endpoint auth (phase 3 - generate any random string)
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
