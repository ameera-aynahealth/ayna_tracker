# Postgres connection string (Neon recommended). Use the pooled connection
# string from Neon's dashboard for DATABASE_URL.
DATABASE_URL=postgres://user:password@host/dbname

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional override. The app also contains the current Ayna org as a fallback.
CLERK_ORGANIZATION_ID=

# Email reminders. In non-production environments emails are suppressed.
RESEND_API_KEY=
AYNA_EMAIL_FROM=Ayna Tracker <tracker@aynahealth.co>

# Vercel Cron authorization. Generate a long random value in production.
CRON_SECRET=

# Public application URL, for deep links in reminder emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
